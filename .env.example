# Gnani AI API Credentials
# Get your API keys from Gnani AI Developer Console
GNANI_API_KEY=
GNANI_STT_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference

# Optional Gnani Evon LLM / Order Intelligence Credentials
# If absent or invalid, Dukaan Saathi smoothly falls back to its deterministic Hindi/Hinglish rule parser
EVON_API_KEY=
EVON_ENDPOINT=https://api.gnani.ai/v3.3/evon

# App Settings
MOCK_GNANI_APIS=false
APP_ENV=development
PORT=8000
DATABASE_URL=sqlite:///./dukaan_saathi.db

